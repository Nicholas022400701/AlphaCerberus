# --- User Specific Requests (Big Data & Weights) ---
*.ckpt
*.npz

# --- Python Standard ---
# Python compiled bytecode cache, no need to upload
__pycache__/
*.py[cod]

# --- Environments ---
# Virtual environment folders contain thousands of library files, do not upload
.env
.venv
env/
venv/
ENV/

# --- IDE Settings ---
# Personal IDE settings for VSCode or PyCharm, not needed by others
.vscode/
.idea/

# --- System Junk ---
# System-generated files from Windows and Mac
Thumbs.db
Desktop.ini
.DS_Store

# --- Other Model/Data Formats (Just in case) ---
# These formats can also cause issues if not ignored
*.pth
*.h5
*.pkl
*.model
data/